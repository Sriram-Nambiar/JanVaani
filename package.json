{
  "name": "janvaani",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun --filter \"*\" --parallel dev",
    "dev:web": "bun --filter @janvaani/web dev",
    "dev:api": "bun --filter @janvaani/api dev",
    "dev:seva-portal": "bun --filter @janvaani/seva-portal dev",
    "dev:seva-api": "bun --filter @janvaani/seva-api dev",
    "start:whatsapp": "bun run apps/api/src/bot-runner.ts",
    "build": "bun --filter \"*\" build",
    "typecheck": "bun --filter \"*\" typecheck",
    "test": "bun test apps/api/src",
    "test:seva": "bun test apps/seva-api/src",
    "test:all": "bun test apps/api/src apps/seva-api/src"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/qrcode-terminal": "^0.12.2"
  }
}
